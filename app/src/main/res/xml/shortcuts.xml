<?xml version="1.0" encoding="utf-8"?>
<!-- Le menu de l'app : appui long sur l'icône Apprendre (paquet de release ; la version de débogage n'a pas ce menu). -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="reglages"
        android:enabled="true"
        android:icon="@drawable/ic_sc_settings"
        android:shortcutShortLabel="@string/sc_settings"
        android:shortcutLongLabel="@string/sc_settings_long">
        <intent
            android:action="fr.hadrienrose.apprendre.SETTINGS"
            android:targetPackage="fr.hadrienrose.apprendre"
            android:targetClass="fr.hadrienrose.apprendre.MainActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="maj"
        android:enabled="true"
        android:icon="@drawable/ic_sc_update"
        android:shortcutShortLabel="@string/sc_update"
        android:shortcutLongLabel="@string/check_updates">
        <intent
            android:action="fr.hadrienrose.apprendre.CHECK_UPDATE"
            android:targetPackage="fr.hadrienrose.apprendre"
            android:targetClass="fr.hadrienrose.apprendre.MainActivity" />
    </shortcut>
</shortcuts>
